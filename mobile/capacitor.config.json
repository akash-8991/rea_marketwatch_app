{
  "appId": "io.github.akash8991.marketlens",
  "appName": "MarketLens",
  "webDir": "www",
  "backgroundColor": "#ffffff",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
